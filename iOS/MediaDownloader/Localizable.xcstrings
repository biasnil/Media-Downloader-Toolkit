    "Media Downloader has no servers, no accounts, no analytics, no tracking and no ads. Nothing about you is collected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader n'a ni serveur, ni compte, ni statistiques, ni suivi, ni publicité. Rien sur vous n'est collecté."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader 没有服务器、没有账户、没有统计分析、没有跟踪，也没有广告。不会收集任何关于你的信息。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader tiada pelayan, tiada akaun, tiada analitik, tiada penjejakan dan tiada iklan. Tiada apa-apa tentang anda dikumpul."
          }
        }
      }
    },
    "Media Downloader is an independent personal project. It isn't made, endorsed or supported by YouTube, Google, Meta, Reddit, X or any other site." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader est un projet personnel indépendant. Il n'est ni créé, ni approuvé, ni soutenu par YouTube, Google, Meta, Reddit, X ou un autre site."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader 是一个独立的个人项目，并非由 YouTube、Google、Meta、Reddit、X 或任何其他网站制作、认可或支持。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media Downloader ialah projek peribadi bebas. Ia tidak dibuat, disokong atau diiktiraf oleh YouTube, Google, Meta, Reddit, X atau mana-mana laman lain."
          }
