    "At once" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En même temps"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时下载"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serentak"
          }
        }
      }
    },
    "At once: how many files download at the same time. 2–3 is faster; more can get you blocked by YouTube for a while.\n\nSpeed limit: the total for all downloads, handy on mobile data." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En même temps : combien de fichiers se téléchargent à la fois. 2 ou 3, c'est plus rapide ; plus, et YouTube peut vous bloquer un moment.\n\nLimite de vitesse : le total pour tous les téléchargements, pratique en données mobiles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时下载：同一时间下载几个文件。2–3 个更快；再多可能会被 YouTube 暂时封锁。\n\n速度限制：所有下载的总速度，使用流量时很实用。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serentak: berapa fail dimuat turun pada masa yang sama. 2–3 lebih laju; lebih daripada itu boleh menyebabkan YouTube menyekat anda buat sementara.\n\nHad kelajuan: jumlah untuk semua muat turun, berguna semasa guna data mudah alih."
          }
        }
      }
    },
