    "Log out in Settings → Accounts to remove a login. Clear History removes the list. Deleting the app removes everything it stored." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnectez-vous dans Réglages → Comptes pour supprimer une connexion. Effacer l'historique supprime la liste. Supprimer l'app efface tout ce qu'elle a enregistré."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置 → 账户中退出登录即可删除登录信息。清除历史记录会删除列表。删除 App 会移除它存储的所有内容。"
          }
        },
        "ms" : {
