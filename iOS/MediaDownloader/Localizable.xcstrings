    "Keep downloading when locked" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer si l'iPhone est verrouillé"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁屏时继续下载"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teruskan muat turun semasa dikunci"
          }
        }
      }
    },
    "Keep downloading when locked: plays silent audio during downloads so iPhone doesn't pause the app. It mixes with your music and stops when downloads finish.\n\nLive Activity: progress on the Lock Screen and in the Dynamic Island." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer si l'iPhone est verrouillé : joue un son silencieux pendant les téléchargements pour que l'iPhone ne mette pas l'app en pause. Il se mélange à votre musique et s'arrête à la fin des téléchargements.\n\nActivité en direct : la progression sur l'écran verrouillé et dans la Dynamic Island."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁屏时继续下载：下载时播放无声音频，让 iPhone 不会暂停 App。它会和你的音乐同时播放，下载完成后停止。\n\n实时活动：在锁定屏幕和灵动岛上显示进度。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teruskan muat turun semasa dikunci: memainkan audio senyap semasa muat turun supaya iPhone tidak menjeda app. Ia bercampur dengan muzik anda dan berhenti apabila muat turun selesai.\n\nAktiviti Langsung: kemajuan pada Skrin Kunci dan dalam Dynamic Island."
          }
        }
      }
    },
