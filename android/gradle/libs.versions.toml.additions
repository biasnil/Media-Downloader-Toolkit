# Not a full libs.versions.toml — add these lines to yours,
# under the [versions] and [libraries] headers that already exist.

[versions]
youtubedlAndroid = "0.18.1"
documentfile = "1.1.0"

[libraries]
youtubedl-library = { group = "io.github.junkfood02.youtubedl-android", name = "library", version.ref = "youtubedlAndroid" }
youtubedl-ffmpeg = { group = "io.github.junkfood02.youtubedl-android", name = "ffmpeg", version.ref = "youtubedlAndroid" }
androidx-documentfile = { group = "androidx.documentfile", name = "documentfile", version.ref = "documentfile" }
