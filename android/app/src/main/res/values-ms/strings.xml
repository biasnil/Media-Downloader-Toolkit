    <string name="terms_title">Terma &amp; Syarat</string>
    <string name="terms_intro">Sila baca dan setuju sebelum menggunakan Media Downloader. Anda akan ditanya semula setiap 10 hari.</string>
    <string name="terms_1_title">Untuk kegunaan peribadi sahaja</string>
    <string name="terms_1_text">Muat turun hanya kandungan milik anda, yang anda dibenarkan simpan, atau yang dibenarkan oleh undang-undang tempat anda (contohnya untuk ditonton sendiri di luar talian). Jangan kongsi, muat naik atau jual apa yang anda muat turun.</string>
    <string name="terms_2_title">Patuhi peraturan setiap laman</string>
    <string name="terms_2_text">YouTube, Spotify, Instagram, TikTok, Facebook, Reddit, X dan laman lain mempunyai terma sendiri, dan memuat turun boleh melanggarnya. Anda bertanggungjawab atas cara anda menggunakan apl ini.</string>
    <string name="terms_3_title">Tiada gabungan</string>
    <string name="terms_3_text">Media Downloader ialah projek peribadi bebas. Ia tidak dibuat, disokong atau diiktiraf oleh YouTube, Google, Spotify, Meta, TikTok, Reddit, X atau mana-mana laman lain.</string>
    <string name="terms_4_title">Semuanya kekal di telefon anda</string>
    <string name="terms_4_text">Apl ini tiada pelayan, akaun, analitik, penjejakan atau iklan. Muat turun, sejarah dan tetapan anda tidak pernah meninggalkan telefon ini.</string>
    <string name="terms_5_title">Tiada jaminan</string>
    <string name="terms_5_text">App ini disediakan seadanya. Laman kerap berubah, jadi muat turun boleh berhenti berfungsi bila-bila masa. Pembangun tidak bertanggungjawab atas sebarang kerugian atau kerosakan akibat penggunaannya.</string>
    <string name="i_agree">Saya Setuju</string>
    <string name="terms_agreed">Anda bersetuju pada %1$s. Anda akan ditanya semula pada %2$s.</string>
    <string name="privacy_title">Privasi</string>
    <string name="privacy_summary">Media Downloader tiada pelayan, tiada akaun, tiada analitik, tiada penjejakan dan tiada iklan. Tiada apa-apa tentang anda dikumpul.</string>
    <string name="privacy_stored_title">Disimpan hanya di telefon ini</string>
    <string name="privacy_stored_files">Fail yang dimuat turun (Download/MediaDownloader, atau folder yang anda pilih)</string>
    <string name="privacy_stored_history">Sejarah muat turun</string>
    <string name="privacy_stored_settings">Seting</string>
    <string name="privacy_online_title">Apa yang pergi ke dalam talian</string>
    <string name="privacy_online">Hanya permintaan yang diperlukan untuk memuat turun daripada pautan yang anda tampal, sama seperti membukanya dalam pelayar (untuk Spotify: halaman lagu awamnya, kemudian carian YouTube), serta semakan kemas kini yt-dlp di GitHub. Laporan hanya dihantar jika anda memilihnya, dan anda melihat semua kandungannya dahulu.</string>
    <string name="privacy_delete_title">Membuang data anda</string>
    <string name="privacy_delete">Kosongkan Sejarah membuang senarai itu. Mengosongkan storan apl atau menyahpasangnya membuang semua yang disimpannya, kecuali fail yang anda muat turun.</string>
