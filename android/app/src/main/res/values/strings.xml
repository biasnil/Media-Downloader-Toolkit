    <string name="terms_title">Terms &amp; Conditions</string>
    <string name="terms_intro">Please read and agree before using Media Downloader. You\'ll be asked again every 10 days.</string>
    <string name="terms_1_title">Personal use only</string>
    <string name="terms_1_text">Only download content you own, have permission to save, or are allowed to keep where you live (for example, to watch offline yourself). Don\'t share, upload or sell what you download.</string>
    <string name="terms_2_title">Follow each site\'s rules</string>
    <string name="terms_2_text">YouTube, Spotify, Instagram, TikTok, Facebook, Reddit, X and other sites have their own terms, and downloading can go against them. You are responsible for how you use this app.</string>
    <string name="terms_3_title">Not affiliated</string>
    <string name="terms_3_text">Media Downloader is an independent personal project. It isn\'t made, endorsed or supported by YouTube, Google, Spotify, Meta, TikTok, Reddit, X or any other site.</string>
    <string name="terms_4_title">Everything stays on your phone</string>
    <string name="terms_4_text">The app has no servers, accounts, analytics, tracking or ads. Your downloads, history and settings never leave this phone.</string>
    <string name="terms_5_title">No warranty</string>
    <string name="terms_5_text">The app is provided as is. Sites change often, so downloads can stop working at any time. The developer isn\'t responsible for any loss or damage from using it.</string>
    <string name="i_agree">I Agree</string>
    <string name="terms_agreed">You agreed on %1$s. You\'ll be asked again on %2$s.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_summary">Media Downloader has no servers, no accounts, no analytics, no tracking and no ads. Nothing about you is collected.</string>
    <string name="privacy_stored_title">Stored only on this phone</string>
    <string name="privacy_stored_files">Downloaded files (Download/MediaDownloader, or the folder you chose)</string>
    <string name="privacy_stored_history">Download history</string>
    <string name="privacy_stored_settings">Settings</string>
    <string name="privacy_online_title">What goes online</string>
    <string name="privacy_online">Only the requests needed to download from the links you paste, the same as opening them in a browser (for Spotify: its public song page, then a YouTube search), plus a check for yt-dlp updates on GitHub. A report is sent only if you choose to, and you see everything in it first.</string>
    <string name="privacy_delete_title">Removing your data</string>
    <string name="privacy_delete">Clear History removes the list. Clearing the app\'s storage or uninstalling it removes everything it stored, except the files you downloaded.</string>
    <string name="ack_title">Acknowledgements</string>
    <string name="ack_thanks">Media Downloader is built with these open-source projects. Thank you!</string>
    <string name="ack_ytdlp">Reads videos from YouTube and 1,800+ other sites.</string>
    <string name="ack_youtubedl">Runs yt-dlp, Python and FFmpeg on Android.</string>
    <string name="ack_ffmpeg">Converts audio and merges video.</string>
    <string name="ack_python">Runs yt-dlp.</string>
    <string name="ack_coil">Shows thumbnails in the pickers.</string>
