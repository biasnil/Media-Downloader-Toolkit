    <string name="terms_title">Conditions d\'utilisation</string>
    <string name="terms_intro">Veuillez lire et accepter avant d\'utiliser Media Downloader. Cela vous sera redemandé tous les 10 jours.</string>
    <string name="terms_1_title">Usage personnel uniquement</string>
    <string name="terms_1_text">Ne téléchargez que du contenu qui vous appartient, que vous avez le droit d\'enregistrer, ou que la loi de votre pays vous permet de garder (par exemple pour le regarder vous-même hors ligne). Ne partagez, ne publiez et ne vendez pas ce que vous téléchargez.</string>
    <string name="terms_2_title">Respectez les règles de chaque site</string>
    <string name="terms_2_text">YouTube, Spotify, Instagram, TikTok, Facebook, Reddit, X et les autres sites ont leurs propres conditions, et le téléchargement peut les enfreindre. Vous êtes responsable de l\'usage que vous faites de cette appli.</string>
    <string name="terms_3_title">Aucune affiliation</string>
    <string name="terms_3_text">Media Downloader est un projet personnel indépendant. Il n\'est ni créé, ni approuvé, ni soutenu par YouTube, Google, Spotify, Meta, TikTok, Reddit, X ou tout autre site.</string>
    <string name="terms_4_title">Tout reste sur votre téléphone</string>
    <string name="terms_4_text">L\'appli n\'a ni serveur, ni compte, ni statistiques, ni suivi, ni publicité. Vos téléchargements, votre historique et vos réglages ne quittent jamais ce téléphone.</string>
    <string name="terms_5_title">Aucune garantie</string>
    <string name="terms_5_text">L\'app est fournie telle quelle. Les sites changent souvent, donc les téléchargements peuvent cesser de fonctionner à tout moment. Le développeur n\'est pas responsable des pertes ou dommages liés à son utilisation.</string>
    <string name="i_agree">J\'accepte</string>
    <string name="terms_agreed">Vous avez accepté le %1$s. Cela vous sera redemandé le %2$s.</string>
    <string name="privacy_title">Confidentialité</string>
    <string name="privacy_summary">Media Downloader n\'a ni serveur, ni compte, ni statistiques, ni suivi, ni publicité. Rien sur vous n\'est collecté.</string>
    <string name="privacy_stored_title">Stocké uniquement sur ce téléphone</string>
    <string name="privacy_stored_files">Fichiers téléchargés (Download/MediaDownloader, ou le dossier que vous avez choisi)</string>
    <string name="privacy_stored_history">L\'historique des téléchargements</string>
    <string name="privacy_stored_settings">Réglages</string>
    <string name="privacy_online_title">Ce qui passe par Internet</string>
    <string name="privacy_online">Uniquement les requêtes nécessaires pour télécharger depuis les liens que vous collez, comme si vous les ouvriez dans un navigateur (pour Spotify : sa page publique du titre, puis une recherche YouTube), plus une vérification des mises à jour de yt-dlp sur GitHub. Un rapport n\'est envoyé que si vous le choisissez, et vous en voyez tout le contenu avant.</string>
    <string name="privacy_delete_title">Supprimer vos données</string>
    <string name="privacy_delete">Effacer l\'historique supprime la liste. Effacer le stockage de l\'appli ou la désinstaller supprime tout ce qu\'elle a enregistré, sauf les fichiers téléchargés.</string>
    <string name="ack_title">Remerciements</string>
    <string name="ack_thanks">Media Downloader utilise ces projets open source. Merci !</string>
    <string name="ack_ytdlp">Lit les vidéos de YouTube et de plus de 1 800 autres sites.</string>
    <string name="ack_youtubedl">Fait fonctionner yt-dlp, Python et FFmpeg sur Android.</string>
    <string name="ack_ffmpeg">Convertit l\'audio et assemble la vidéo.</string>
    <string name="ack_python">Fait fonctionner yt-dlp.</string>
